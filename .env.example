# Vercel deployment
VITE_API_URL=
CLIENT_URL=/

# MongoDB (set real value via: vercel env add MONGO_URI)
MONGO_URI=mongodb://localhost:27017/chaching

# JWT (set real value via: vercel env add JWT_SECRET)
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=7d

# Gemini AI (optional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
